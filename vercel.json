{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "hajin.app" }],
      "destination": "https://hajin-lee.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.hajin.app" }],
      "destination": "https://hajin-lee.com/",
      "statusCode": 301
    }
  ]
}
